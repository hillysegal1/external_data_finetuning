# ===== Dashcam Analyzer v26-adaptive =====

import cv2
import numpy as np
import gc
import requests
import base64
from io import BytesIO
from PIL import Image
from scipy.ndimage import uniform_filter1d
import time

VIDEO_PATH = "/content/military.mp4"
MODEL_ID   = "Qwen/Qwen3-VL-8B-Instruct"

QWEN_ENDPOINT = "https://your-qwen-endpoint/v1/chat/completions"
QWEN_HEADERS  = {
    "Content-Type": "application/json",
}

# --------------------------------------------------
# VIDEO INFO
# --------------------------------------------------

start_time = time.time()

cap = cv2.VideoCapture(VIDEO_PATH)
if not cap.isOpened():
    raise RuntimeError(f"Could not open video: {VIDEO_PATH}")

native_fps   = cap.get(cv2.CAP_PROP_FPS)
total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
if native_fps == 0:
    raise RuntimeError("Could not read FPS")

duration = total_frames / native_fps
print(f"Video duration: {duration:.1f}s  |  FPS: {native_fps}  |  Frames: {total_frames}")

# --------------------------------------------------
# FRAME EXTRACTION
# --------------------------------------------------

FLOW_FPS       = 4
frame_interval = max(1, int(native_fps / FLOW_FPS))
frames         = []
frame_idx      = 0

while True:
    ret, frame = cap.read()
    if not ret:
        break
    if frame_idx % frame_interval == 0:
        ts   = frame_idx / native_fps
        rgb  = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        gray = cv2.cvtColor(cv2.resize(frame, (640, 360)), cv2.COLOR_BGR2GRAY)
        frames.append((ts, gray, float(gray.mean()), rgb))
    frame_idx += 1

cap.release()
print(f"Frames extracted: {len(frames)}")

frame_timestamps = np.array([f[0] for f in frames])

# --------------------------------------------------
# SIGNAL COMPUTATION — full frame flow, detrended
# --------------------------------------------------

flow_variance_scores = [0.0]

for i in range(1, len(frames)):
    flow = cv2.calcOpticalFlowFarneback(
        frames[i-1][1], frames[i][1], None,
        0.5, 3, 15, 3, 5, 1.2, 0
    )
    mag, _ = cv2.cartToPolar(flow[..., 0], flow[..., 1])
    flow_variance_scores.append(float(np.std(mag)))

flow_var_arr = np.array(flow_variance_scores)

# detrend — subtract 10s rolling baseline to remove constant traffic noise
window_frames = int(FLOW_FPS * 10)
baseline      = uniform_filter1d(flow_var_arr, size=window_frames, mode='nearest')
flow_relative = np.maximum(0, flow_var_arr - baseline)

# brightness second derivative
brightness_arr    = np.array([f[2] for f in frames])
d2                = np.abs(np.diff(np.abs(np.diff(brightness_arr))))
brightness_scores = np.concatenate([[0, 0], d2])

def normalize(arr):
    r = arr.max() - arr.min()
    return (arr - arr.min()) / r if r > 0 else np.zeros_like(arr)

importance = normalize(flow_relative) + normalize(brightness_scores)

# --------------------------------------------------
# DERIVE CONFIG
# --------------------------------------------------

def derive_config(importance, frame_timestamps, duration):
    importance_8u     = (importance * 127).astype(np.uint8)
    best_thresh_8u, _ = cv2.threshold(importance_8u, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    best_thresh       = best_thresh_8u / 127.0
    active_mask       = importance > best_thresh
    event_density     = float(active_mask.mean())

    active_times = frame_timestamps[active_mask]
    if len(active_times) > 1:
        gaps   = np.diff(active_times)
        spread = float(gaps.std() / gaps.mean()) if gaps.mean() > 0 else 0.0
    else:
        spread = 0.0

    bucket_s       = float(np.clip(duration * 0.02 / (event_density + 0.1), 3.0, 20.0))
    chunk_busy     = float(np.clip(1.5 + spread * 0.5, 1.5, 4.0))
    chunk_calm     = float(np.clip(duration * 0.03 + 3.0, 3.0, 20.0))
    busy_threshold = float(np.clip(best_thresh * 0.8, 0.3, 0.8))

    skip_percentile    = float(np.clip((1.0 - event_density) * 20, 0.0, 20.0)) if duration > 60 else None
    summary_interval_s = float(np.clip(duration * 0.05, 30.0, 180.0)) if duration > 120 else None
    max_tokens         = int(np.clip(140 - duration * 0.003, 80, 140))

    return dict(
        event_density      = round(event_density, 3),
        spread             = round(spread, 3),
        otsu_threshold     = round(best_thresh, 4),
        bucket_s           = round(bucket_s, 1),
        chunk_busy         = round(chunk_busy, 1),
        chunk_calm         = round(chunk_calm, 1),
        busy_threshold     = round(busy_threshold, 3),
        skip_percentile    = round(skip_percentile, 1) if skip_percentile is not None else None,
        summary_interval_s = round(summary_interval_s, 1) if summary_interval_s is not None else None,
        max_tokens         = max_tokens,
    )

cfg = derive_config(importance, frame_timestamps, duration)

print(f"\n--- AUTO CONFIG ---")
print(f"Event density:    {cfg['event_density']} ({cfg['event_density']*100:.0f}% of frames active)")
print(f"Event spread:     {cfg['spread']} ({'bursty' if cfg['spread'] > 1.0 else 'even'})")
print(f"Otsu threshold:   {cfg['otsu_threshold']}")
print(f"bucket_s:         {cfg['bucket_s']}s")
print(f"chunk_busy:       {cfg['chunk_busy']}s")
print(f"chunk_calm:       {cfg['chunk_calm']}s")
print(f"busy_threshold:   {cfg['busy_threshold']}")
print(f"skip_percentile:  {cfg['skip_percentile']}")
print(f"summary_interval: {cfg['summary_interval_s']}")
print(f"max_tokens:       {cfg['max_tokens']}")

# --------------------------------------------------
# ASSESS OTSU QUALITY
# --------------------------------------------------

def assess_otsu_quality(importance, threshold):
    below = importance[importance <= threshold]
    above = importance[importance > threshold]
    if len(below) == 0 or len(above) == 0:
        return 0.0
    w0      = len(below) / len(importance)
    w1      = len(above) / len(importance)
    between = w0 * w1 * (below.mean() - above.mean()) ** 2
    total   = importance.var()
    return float(between / total) if total > 0 else 0.0

otsu_quality = assess_otsu_quality(importance, cfg["otsu_threshold"])
print(f"Otsu quality:     {otsu_quality:.3f} ({'good' if otsu_quality > 0.5 else 'moderate' if otsu_quality > 0.2 else 'poor — uniform chunking'})")

# --------------------------------------------------
# BUILD CHUNK PLAN
# --------------------------------------------------

skip_threshold = (
    float(np.percentile(importance, cfg["skip_percentile"]))
    if cfg["skip_percentile"] is not None else None
)

chunks = []

if otsu_quality < 0.2 or cfg["event_density"] > 0.85:
    print("\nSignal unimodal — uniform chunking")
    chunk_dur = float(np.clip(2.0 + cfg["spread"] * 0.5, 2.0, 4.0))
    t = 0.0
    while t < duration:
        ce = round(min(t + chunk_dur, duration), 2)
        chunks.append((round(t, 2), ce, "busy"))
        t += chunk_dur
else:
    for bs in np.arange(0, duration, cfg["bucket_s"]):
        be         = min(bs + cfg["bucket_s"], duration)
        bucket_idx = np.where((frame_timestamps >= bs) & (frame_timestamps < be))[0]
        if len(bucket_idx) == 0:
            continue

        mean_imp   = float(importance[bucket_idx].mean())
        chunk_dur  = cfg["chunk_busy"] if mean_imp >= cfg["busy_threshold"] else cfg["chunk_calm"]
        chunk_type = "busy" if mean_imp >= cfg["busy_threshold"] else "calm"

        t = bs
        while t < be:
            cs = round(t, 2)
            ce = round(min(t + chunk_dur, be), 2)
            if ce > cs:
                chunks.append((cs, ce, chunk_type))
            t += chunk_dur

busy_count = sum(1 for *_, ct in chunks if ct == "busy")
calm_count = sum(1 for *_, ct in chunks if ct == "calm")

print(f"\n--- CHUNKS ---")
print(f"Total: {len(chunks)} (busy: {busy_count}, calm: {calm_count})")
for cs, ce, ct in chunks:
    print(f"  [{cs}-{ce}s] {ct} ({ce-cs:.2f}s)")

# --------------------------------------------------
# FRAME SAMPLING
# --------------------------------------------------

def sample_frames(start, end, chunk_type):
    indices = [i for i, (ts, *_) in enumerate(frames) if start <= ts <= end]
    if not indices:
        return []
    if len(indices) <= 2:
        return [Image.fromarray(frames[i][3]) for i in indices]

    first_idx, last_idx = indices[0], indices[-1]
    middle = indices[1:-1]

    if not middle:
        return [Image.fromarray(frames[i][3]) for i in [first_idx, last_idx]]

    sorted_mid = sorted(middle, key=lambda i: importance[i], reverse=True)

    if chunk_type == "busy" and len(sorted_mid) >= 2:
        selected = sorted(set([first_idx, sorted_mid[0], sorted_mid[1], last_idx]))
    else:
        selected = sorted(set([first_idx, sorted_mid[0], last_idx]))

    return [Image.fromarray(frames[i][3]) for i in selected]

# --------------------------------------------------
# PROMPTS
# --------------------------------------------------

SYSTEM_PROMPT = """
You are analyzing dashcam footage frame by frame.

WHAT TO REPORT (only if clearly visible):
- Vehicles: type, color, lane position, direction, whether moving or stopped
- People: location, role if identifiable (military, police, worker, civilian)
- Infrastructure: barriers, cones, checkpoints, signage, lane markings
- Events: lane departure, sudden braking, wrong-way travel, emergency lights, smoke, debris

STRICT RULES:
- Describe only what you can directly see in these frames
- Do not infer, assume, or speculate
- Do not repeat or reference the previous scene unless the same object is still visible
- If nothing notable is happening, say so plainly

RESPONSE FORMAT — always use exactly this structure:
DESCRIPTION: one sentence if nothing changed, two sentences maximum if something happened
STATE: three words maximum summarising what is still present (e.g. "convoy moving, checkpoint ahead")
"""

CHUNK_PROMPT = """
{summary_block}Previous segment ({prev_time}): {prev_state}
Only reference the above if the same vehicle or person is clearly still visible.

Current segment: {start}s to {end}s
Frames shown: {n_frames} ({frame_desc})

Describe what is visible and what changed between the first and last frame.
Two sentences maximum if something happened, one if nothing changed.

DESCRIPTION:
STATE:
"""

# --------------------------------------------------
# CONTEXT
# --------------------------------------------------

def build_context(text, start, end, current_summary):
    state = None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.upper().startswith("STATE:"):
            candidate = stripped.split(":", 1)[1].strip()
            if candidate:
                state = candidate
            break

    if not state:
        for line in text.splitlines():
            if line.strip().upper().startswith("DESCRIPTION:"):
                desc = line.split(":", 1)[1].strip()
                break
        else:
            desc = text.strip()
        short = desc[:80]
        if len(desc) > 80 and " " in short:
            short = short.rsplit(" ", 1)[0]
        state = short

    return {
        "prev_state": state,
        "prev_time":  f"{start}-{end}s",
        "summary":    current_summary,
    }

def clean_output(text):
    lines = []
    for line in text.splitlines():
        s = line.strip()
        if s.upper().startswith("STATE:"):
            continue
        if s.upper().startswith("DESCRIPTION:"):
            remainder = s.split(":", 1)[1].strip()
            if remainder:
                lines.append(remainder)
        elif s:
            lines.append(s)
    return " ".join(lines)

def summarize_recent(timeline_slice):
    states = [state for *_, state in timeline_slice if state]
    if not states:
        return "no notable activity"
    seen, dedup = set(), []
    for s in states:
        if s not in seen:
            seen.add(s)
            dedup.append(s)
    return ", ".join(dedup[-5:])

def format_summary_block(summary):
    if not summary:
        return ""
    return f"Scene context so far: {summary}\n"

# --------------------------------------------------
# API CALL
# --------------------------------------------------

def call_model(messages, max_tokens):
    payload = {
        "model":       MODEL_ID,
        "messages":    messages,
        "max_tokens":  max_tokens,
        "temperature": 0,
    }
    response = requests.post(
        QWEN_ENDPOINT,
        headers=QWEN_HEADERS,
        json=payload,
        timeout=60,
    )
    response.raise_for_status()
    return response.json()["choices"][0]["message"]["content"].strip()

def call_model_with_retry(messages, max_tokens, retries=3, backoff=2.0):
    for attempt in range(retries):
        try:
            return call_model(messages, max_tokens)
        except requests.exceptions.RequestException as e:
            if attempt == retries - 1:
                raise
            wait = backoff * (attempt + 1)
            print(f"  → retry {attempt+1}/{retries} after {wait}s ({e})")
            time.sleep(wait)

def build_messages(frame_imgs, start, end, prev_context):
    frame_desc = (
        "start / two peak moments / end" if len(frame_imgs) == 4
        else "start / peak moment / end"
    )

    prompt = CHUNK_PROMPT.format(
        summary_block = format_summary_block(prev_context.get("summary")),
        start         = start,
        end           = end,
        prev_state    = prev_context["prev_state"],
        prev_time     = prev_context["prev_time"],
        n_frames      = len(frame_imgs),
        frame_desc    = frame_desc,
    )

    image_content = []
    for img in frame_imgs:
        buf = BytesIO()
        img.save(buf, format="JPEG", quality=85)
        b64 = base64.b64encode(buf.getvalue()).decode("utf-8")
        image_content.append({
            "type": "image_url",
            "image_url": {"url": f"data:image/jpeg;base64,{b64}"}
        })

    return [
        {"role": "system", "content": SYSTEM_PROMPT},
        {"role": "user",   "content": image_content + [{"type": "text", "text": prompt}]},
    ]

# --------------------------------------------------
# RUN
# --------------------------------------------------

timeline          = []
prev_context      = {"prev_state": "start of video", "prev_time": "0s", "summary": None}
running_summary   = None
last_summary_time = 0.0
skipped           = 0

for i, (start, end, chunk_type) in enumerate(chunks):
    label = "BUSY" if chunk_type == "busy" else "CALM"
    print(f"Chunk {i+1}/{len(chunks)} [{start}-{end}s] {label} ({end-start:.2f}s)")

    if (cfg["summary_interval_s"] and
        start - last_summary_time >= cfg["summary_interval_s"]):
        running_summary         = summarize_recent(timeline[-15:])
        last_summary_time       = start
        prev_context["summary"] = running_summary
        print(f"  → summary: {running_summary}")

    chunk_idx = np.where((frame_timestamps >= start) & (frame_timestamps <= end))[0]
    if skip_threshold is not None and len(chunk_idx) > 0:
        if float(importance[chunk_idx].mean()) < skip_threshold:
            print(f"  → skipped")
            timeline.append((start, end, chunk_type, "no significant activity", None))
            skipped += 1
            continue

    frame_imgs = sample_frames(start, end, chunk_type)
    if not frame_imgs:
        continue

    try:
        messages     = build_messages(frame_imgs, start, end, prev_context)
        raw_text     = call_model_with_retry(messages, cfg["max_tokens"])
    except requests.exceptions.RequestException as e:
        print(f"  → API error: {e}")
        timeline.append((start, end, chunk_type, "API error", None))
        continue

    prev_context = build_context(raw_text, start, end, running_summary)
    display_text = clean_output(raw_text)
    timeline.append((start, end, chunk_type, display_text, prev_context["prev_state"]))
    print(f"  → {display_text}")

# --------------------------------------------------
# OUTPUT
# --------------------------------------------------

def print_timeline(timeline, duration):
    busy_entries = [(s, e, t) for s, e, ct, t, _ in timeline if ct == "busy"]

    if duration >= 120 and busy_entries:
        print("\nNOTABLE EVENTS\n" + "-" * 40)
        for s, e, t in busy_entries:
            mins_s = int(s // 60)
            mins_e = int(e // 60)
            ts     = f"{mins_s}:{int(s%60):02d}-{mins_e}:{int(e%60):02d}"
            print(f"[{ts}] {t}")

    print("\nFULL TIMELINE\n" + "-" * 40)
    for s, e, ct, t, state in timeline:
        if duration >= 120:
            mins_s = int(s // 60)
            mins_e = int(e // 60)
            ts     = f"{mins_s}:{int(s%60):02d}-{mins_e}:{int(e%60):02d}"
        else:
            ts = f"{s}-{e}s"
        tag = " [BUSY]" if ct == "busy" else ""
        print(f"[{ts}]{tag} {t}")
        if state and ct == "busy":
            print(f"         → {state}")

print_timeline(timeline, duration)

print(f"\nTotal chunks:  {len(chunks)}")
print(f"Model calls:   {len(chunks) - skipped}")
print(f"Skipped:       {skipped}")
print(f"Runtime:       {time.time() - start_time:.1f}s")
