# ── Cell 1: Config ─────────────────────────────────────────────────────────────
from ultralytics import YOLO
from pathlib import Path
from itertools import groupby
from IPython.display import display, Markdown
import numpy as np
import yaml
import matplotlib.pyplot as plt

MODEL_PATH  = "your_finetuned_model.pt"
DATA_YAML   = "data.yaml"
MIN_CONF    = 0.1        # low enough to catch everything
IOU_THRESH  = 0.5        # IoU to match detection to GT box

CLASS_MAP = {
    0: "soldier",
    1: "barrier",
    2: "civilian",
}
VALID_LABELS = {"soldier", "civilian"}


# ── Cell 2: Load val images grouped by video ───────────────────────────────────
with open(DATA_YAML) as f:
    data_cfg = yaml.safe_load(f)

data_root = Path(data_cfg.get("path", "."))
val_imgs  = data_root / data_cfg["val"]
label_dir = Path(str(val_imgs).replace("images", "labels"))

print(f"Val images : {val_imgs}  exists={val_imgs.exists()}")
print(f"Labels     : {label_dir}  exists={label_dir.exists()}")

def get_video_id(path: Path) -> str:
    # "frame_vid_07_000315.jpg" -> "vid_07"
    parts = path.stem.split("_")
    return f"{parts[1]}_{parts[2]}"

image_paths = sorted(val_imgs.glob("*.jpg")) + sorted(val_imgs.glob("*.png"))
image_paths = sorted(image_paths, key=get_video_id)

video_groups = {
    vid_id: sorted(paths)
    for vid_id, paths in groupby(image_paths, key=get_video_id)
}

print(f"\nFound {len(video_groups)} videos:")
for vid_id, paths in video_groups.items():
    print(f"  {vid_id}: {len(paths)} frames")


# ── Cell 3: Helpers ────────────────────────────────────────────────────────────
def load_gt(label_path: Path, img_w: int, img_h: int) -> list:
    """Load YOLO format GT labels. Returns list of {class, bbox [x1,y1,x2,y2]}."""
    if not label_path.exists():
        return []
    gt_boxes = []
    with open(label_path) as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 5:
                continue
            cls_id          = int(parts[0])
            xc, yc, bw, bh = map(float, parts[1:5])
            x1 = int((xc - bw / 2) * img_w)
            y1 = int((yc - bh / 2) * img_h)
            x2 = int((xc + bw / 2) * img_w)
            y2 = int((yc + bh / 2) * img_h)
            class_name = CLASS_MAP.get(cls_id)
            if class_name in VALID_LABELS:
                gt_boxes.append({"class": class_name, "bbox": [x1, y1, x2, y2]})
    return gt_boxes


def compute_iou(box_a: list, box_b: list) -> float:
    xa1 = max(box_a[0], box_b[0])
    ya1 = max(box_a[1], box_b[1])
    xa2 = min(box_a[2], box_b[2])
    ya2 = min(box_a[3], box_b[3])
    inter = max(0, xa2 - xa1) * max(0, ya2 - ya1)
    if inter == 0:
        return 0.0
    area_a = (box_a[2] - box_a[0]) * (box_a[3] - box_a[1])
    area_b = (box_b[2] - box_b[0]) * (box_b[3] - box_b[1])
    return inter / (area_a + area_b - inter)


def match_to_gt(det_bbox: list, gt_boxes: list) -> str | None:
    """Match detection to best overlapping GT box. Returns GT class or None."""
    best_iou   = IOU_THRESH
    best_class = None
    for gt in gt_boxes:
        iou = compute_iou(det_bbox, gt["bbox"])
        if iou > best_iou:
            best_iou   = iou
            best_class = gt["class"]
    return best_class


# ── Cell 4: Run YOLO predict and collect detections ───────────────────────────
model = YOLO(MODEL_PATH)

# Each entry: {conf, pred_label, gt_label}
# gt_label is None if detection didn't match any GT box (false positive)
all_detections = []

for vid_id, vid_frames in video_groups.items():
    print(f"\nProcessing {vid_id} ({len(vid_frames)} frames)...")
    n_dets = 0

    results = model.predict(
        source=sorted([str(p) for p in vid_frames]),
        conf=MIN_CONF,
        iou=0.5,
        stream=True,
        device=0,
        imgsz=1280,
        classes=[0, 2],   # soldier, civilian only
        half=True,
        verbose=False,
    )

    for frame_idx, result in enumerate(results):
        img_path   = vid_frames[frame_idx]
        label_path = label_dir / img_path.with_suffix(".txt").name
        img_h, img_w = result.orig_img.shape[:2]

        gt_boxes = load_gt(label_path, img_w, img_h)

        if result.boxes is None or len(result.boxes) == 0:
            continue

        for i in range(len(result.boxes)):
            pred_label = result.names[int(result.boxes.cls[i].cpu().item())]
            if pred_label not in VALID_LABELS:
                continue

            conf            = float(result.boxes.conf[i].cpu().item())
            x1, y1, x2, y2 = map(int, result.boxes.xyxy[i].cpu().numpy())
            gt_label        = match_to_gt([x1, y1, x2, y2], gt_boxes)

            all_detections.append({
                "conf":       conf,
                "pred_label": pred_label,
                "gt_label":   gt_label,   # None = no GT match (likely FP)
                "video_id":   vid_id,
            })
            n_dets += 1

        if frame_idx % 500 == 0:
            print(f"  Frame {frame_idx}/{len(vid_frames)}  dets so far: {n_dets}")

    print(f"  Done. Detections this video: {n_dets}")

print(f"\nTotal detections across all videos: {len(all_detections)}")


# ── Cell 5: Split into categories ─────────────────────────────────────────────
# Only look at detections that matched a GT box
matched = [d for d in all_detections if d["gt_label"] is not None]

correct_soldier  = [d for d in matched if d["gt_label"] == "soldier"  and d["pred_label"] == "soldier"]
missed_soldier   = [d for d in matched if d["gt_label"] == "soldier"  and d["pred_label"] == "civilian"]
correct_civilian = [d for d in matched if d["gt_label"] == "civilian" and d["pred_label"] == "civilian"]
false_soldier    = [d for d in matched if d["gt_label"] == "civilian" and d["pred_label"] == "soldier"]

display(Markdown(f"""
## Detection breakdown
| Category | Count | % of matched |
|---|---|---|
| Correct soldier | {len(correct_soldier)} | {len(correct_soldier)/len(matched)*100:.1f}% |
| Missed soldier (predicted civilian) | {len(missed_soldier)} | {len(missed_soldier)/len(matched)*100:.1f}% |
| Correct civilian | {len(correct_civilian)} | {len(correct_civilian)/len(matched)*100:.1f}% |
| False soldier (civilian predicted soldier) | {len(false_soldier)} | {len(false_soldier)/len(matched)*100:.1f}% |
| Unmatched (no GT box) | {len(all_detections) - len(matched)} | - |
"""))


# ── Cell 6: Confidence distribution plots ─────────────────────────────────────
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

# Left plot: soldier confusion
ax = axes[0]
ax.hist([d["conf"] for d in correct_soldier],
        bins=30, alpha=0.6, color="green", label=f"correct soldier (n={len(correct_soldier)})")
ax.hist([d["conf"] for d in missed_soldier],
        bins=30, alpha=0.6, color="red",   label=f"missed soldier (n={len(missed_soldier)})")
ax.set_title("Soldier detections — correct vs missed", fontsize=12)
ax.set_xlabel("YOLO confidence")
ax.set_ylabel("Count")
ax.legend()

# Right plot: civilian confusion
ax = axes[1]
ax.hist([d["conf"] for d in correct_civilian],
        bins=30, alpha=0.6, color="blue",   label=f"correct civilian (n={len(correct_civilian)})")
ax.hist([d["conf"] for d in false_soldier],
        bins=30, alpha=0.6, color="orange", label=f"civilian called soldier (n={len(false_soldier)})")
ax.set_title("Civilian detections — correct vs false alarm", fontsize=12)
ax.set_xlabel("YOLO confidence")
ax.set_ylabel("Count")
ax.legend()

plt.tight_layout()
plt.show()

# Print stats
for name, dets in [("correct soldier",  correct_soldier),
                   ("missed soldier",   missed_soldier),
                   ("correct civilian", correct_civilian),
                   ("false soldier",    false_soldier)]:
    confs = [d["conf"] for d in dets]
    if confs:
        print(f"{name:35s}: mean={np.mean(confs):.3f}  "
              f"std={np.std(confs):.3f}  "
              f"min={np.min(confs):.3f}  "
              f"max={np.max(confs):.3f}")


# ── Cell 7: Threshold analysis ────────────────────────────────────────────────
display(Markdown("## Finding optimal Qwen thresholds"))

thresholds = np.linspace(0.1, 1.0, 100)

# For soldiers: send to Qwen if conf < threshold
soldier_rows = []
for thresh in thresholds:
    caught     = sum(1 for d in missed_soldier   if d["conf"] < thresh)
    total_sent = sum(1 for d in matched
                     if d["pred_label"] == "soldier" and d["conf"] < thresh)
    recall     = caught / len(missed_soldier) if missed_soldier else 0
    cost       = total_sent / len(matched) * 100 if matched else 0
    soldier_rows.append((thresh, recall, cost))

# For civilians: send to Qwen if conf > threshold
civilian_rows = []
for thresh in thresholds:
    caught     = sum(1 for d in false_soldier    if d["conf"] > thresh)
    total_sent = sum(1 for d in matched
                     if d["pred_label"] == "civilian" and d["conf"] > thresh)
    recall     = caught / len(false_soldier) if false_soldier else 0
    cost       = total_sent / len(matched) * 100 if matched else 0
    civilian_rows.append((thresh, recall, cost))

fig, axes = plt.subplots(1, 2, figsize=(16, 5))

for ax, rows, title, xlabel in [
    (axes[0], soldier_rows,  "Soldier threshold (send to Qwen if conf < threshold)",  "conf threshold"),
    (axes[1], civilian_rows, "Civilian threshold (send to Qwen if conf > threshold)", "conf threshold"),
]:
    threshs = [r[0] for r in rows]
    recalls = [r[1] for r in rows]
    costs   = [r[2] / 100 for r in rows]

    # Best = maximise recall - cost tradeoff
    best_idx    = max(range(len(rows)), key=lambda i: rows[i][1] - rows[i][2] / 100)
    best_thresh = rows[best_idx][0]

    ax.plot(threshs, recalls, color="red",  linewidth=2, label="recall of confused detections")
    ax.plot(threshs, costs,   color="blue", linewidth=2, label="fraction of all dets sent to Qwen")
    ax.axvline(best_thresh, color="green", linestyle="--",
               label=f"suggested = {best_thresh:.2f}  "
                     f"(recall={rows[best_idx][1]:.2f}, "
                     f"cost={rows[best_idx][2]:.1f}%)")
    ax.set_title(title, fontsize=10)
    ax.set_xlabel(xlabel)
    ax.set_ylabel("Fraction")
    ax.set_ylim(0, 1.05)
    ax.legend(fontsize=8)

plt.tight_layout()
plt.show()

# Print suggestions
soldier_best  = max(range(len(soldier_rows)),
                    key=lambda i: soldier_rows[i][1] - soldier_rows[i][2] / 100)
civilian_best = max(range(len(civilian_rows)),
                    key=lambda i: civilian_rows[i][1] - civilian_rows[i][2] / 100)

display(Markdown(f"""
## Suggested thresholds for your pipeline

```python
# Send soldier detection to Qwen if YOLO conf is below this
SOLDIER_QWEN_THRESHOLD  = {soldier_rows[soldier_best][0]:.2f}

# Send civilian detection to Qwen if YOLO conf is above this  
CIVILIAN_QWEN_THRESHOLD = {civilian_rows[civilian_best][0]:.2f}

def should_send_to_qwen(pred_label, conf):
    if pred_label == "soldier"  and conf < SOLDIER_QWEN_THRESHOLD:  return True
    if pred_label == "civilian" and conf > CIVILIAN_QWEN_THRESHOLD: return True
    return False
```

| | Threshold | Catches | Qwen cost |
|---|---|---|---|
| Soldier | {soldier_rows[soldier_best][0]:.2f} | {soldier_rows[soldier_best][1]*100:.1f}% of missed soldiers | {soldier_rows[soldier_best][2]:.1f}% of all dets |
| Civilian | {civilian_rows[civilian_best][0]:.2f} | {civilian_rows[civilian_best][1]*100:.1f}% of false alarms | {civilian_rows[civilian_best][2]:.1f}% of all dets |
"""))
